# ------------------------------------------------------------------
# DealSense environment
# Copy this file to .env.local and fill in what you have.
# Everything is OPTIONAL — the app runs with zero config (local SQLite).
# ------------------------------------------------------------------

# Database
# Leave empty for local SQLite file at ./data/dealsense.db
# For production (free), create a Turso database: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://dealsense.in

# Affiliate
NEXT_PUBLIC_AMAZON_TAG=dealsense-21
NEXT_PUBLIC_CUELINKS_CHANNEL=317867

# ------------------------------------------------------------------
# LIVE PRICE EXTRACTION
# ------------------------------------------------------------------
# Amazon.in works out of the box (direct fetch).
# Flipkart works out of the box too — DealSense uses Flipkart's own page API
# (no proxy, no key, no browser needed).
#
# OPTIONAL: a scraping provider is only a *fallback* if the built-in paths are
# ever blocked. If you set one, it is tried automatically.
#   ScraperAPI   https://scraperapi.com       (1,000 free / month)
#   ScrapingBee  https://scrapingbee.com      (1,000 free credits)
#   ZenRows      https://zenrows.com          (1,000 free credits)
# NOTE: ScrapingAnt's FREE plan blocks Amazon/Flipkart domains.
SCRAPERAPI_KEY=
SCRAPINGBEE_API_KEY=
ZENROWS_API_KEY=
SCRAPINGANT_API_KEY=
# Or any custom proxy endpoint that accepts ?url=... (or a {url} placeholder)
SCRAPER_ENDPOINT=

# Optional: use a local headless browser (npm i -D playwright && npx playwright install chromium)
USE_PLAYWRIGHT=0

# Telegram alert delivery (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT=

# Email alert delivery (optional — Resend free tier)
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@dealsense.in

# Cron protection (optional)
CRON_SECRET=
