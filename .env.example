# DealSense Environment Configuration Example
# Copy this file to .env and configure with your keys

# Cuelinks Publisher API
CUELINKS_API_KEY=your_cuelinks_api_key_here

# Amazon Associates Tag
AMAZON_AFFILIATE_TAG=dealsense-21

# Telegram Price Alert Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Deal Bot (Optional)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Google Gemini API Key (For AI deal intelligence & setup builder)
GEMINI_API_KEY=your_gemini_api_key_here

# Canonical Backend URL (Used by Vercel serverless proxy if deployed separately)
BACKEND_URL=http://127.0.0.1:8000
