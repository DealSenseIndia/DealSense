{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/sweep",
      "schedule": "0 */4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/deals/live",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=180"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/deals", "destination": "/frontend/deals.html" },
    { "source": "/deals.html", "destination": "/frontend/deals.html" },
    { "source": "/categories", "destination": "/frontend/categories.html" },
    { "source": "/categories.html", "destination": "/frontend/categories.html" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/favicon.ico", "destination": "/frontend/favicon.ico" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/css/(.*)", "destination": "/frontend/css/$1" },
    { "source": "/js/(.*)", "destination": "/frontend/js/$1" },
    { "source": "/templates/(.*)", "destination": "/frontend/templates/$1" },
    { "source": "/style.css", "destination": "/frontend/style.css" },
    { "source": "/app.js", "destination": "/frontend/app.js" }
  ]
}
