{
  "manifest_version": 3,
  "name": "DealSense — Smart Price & Deal Intelligence",
  "short_name": "DealSense",
  "version": "1.0.0",
  "description": "Live price history, fake discount verification, Indian bank card offer calculators, and one-click deal alerts for Amazon.in & Flipkart.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DealSense Deal Intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.in/*",
        "https://*.flipkart.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.amazon.in/*",
    "https://*.flipkart.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://api.dealsense.in/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://*.amazon.in/*",
        "https://*.flipkart.com/*"
      ]
    }
  ]
}
